{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 herramientas/tutor.py estado || true",
            "timeout": 30,
            "statusMessage": "Cargando el estado del tutor…"
          }
        ]
      }
    ]
  }
}
